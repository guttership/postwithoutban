// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modèles pour NextAuth.js (Adapter Prisma)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Modèle pour les achats (accès sans compte)
model Purchase {
  id              String   @id @default(cuid())
  email           String   @unique
  accessToken     String   @unique
  stripeSessionId String   @unique
  stripeCustomerId String?
  language        String   @default("fr") // 'fr' ou 'en'
  createdAt       DateTime @default(now())
  activatedAt     DateTime?
  lastAccessAt    DateTime?
  accessCount     Int      @default(0)
  isActive        Boolean  @default(true)
  
  // Tracking des sessions pour détection du partage
  activeSessions  ActiveSession[]

  @@index([email])
  @@index([accessToken])
}

// Modèle pour tracker les sessions actives d'un token
model ActiveSession {
  id          String   @id @default(cuid())
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  
  // Info de la session
  ipAddress   String
  userAgent   String
  deviceHash  String    // Hash du device (User-Agent + screen size)
  
  // Timing
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  expiresAt   DateTime
  
  @@index([purchaseId])
  @@index([deviceHash])
}
